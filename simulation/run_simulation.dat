/BATCH
/CLEAR,NOSTART

/PREP7
CHIP_W = 0.0360
CHIP_L = 0.0360
CHIP_H = 0.0008
SPREAD_H = 0.0016
FIN_H = 0.0050
RADIUS_FIN = 0.0005
S_PITCH_X = 0.0022
S_PITCH_Y = 0.0022

FLUID_AMB_T = 18.0
COOL_H_BASE = 1450.0
T_REF_ZERO = 22.0

*DIM,TIME_STEPS,ARRAY,40
*DO,t_i,1,40
    TIME_STEPS(t_i) = t_i * 0.025
*ENDDO

*DIM,PULSE_FLUX,ARRAY,40
*DO,t_i,1,40
    *IF,MOD(t_i,4),LE,1,THEN
        PULSE_FLUX(t_i) = 3800000.0
    *ELSE
        PULSE_FLUX(t_i) = 450000.0
    *ENDIF
*ENDDO

MPTEMP,1,20,50,80,110,140,170
MPDATA,KXX,1,1,391,385,378,370,362,354
MPDATA,C,1,1,385,392,400,408,415,422
MPDATA,DENS,1,1,8920,8910,8900,8890,8880,8870

MPTEMP,1,20,60,100,140,180,220
MPDATA,KXX,5,1,120,115,108,102,95,88
MPDATA,C,5,1,750,785,820,850,875,895
MPDATA,DENS,5,1,3210,3208,3205,3201,3196,3190

BLOCK, 0, CHIP_W, 0, CHIP_L, 0, CHIP_H
BLOCK, 0, CHIP_W, 0, CHIP_L, CHIP_H, CHIP_H+SPREAD_H

Z1 = CHIP_H + SPREAD_H
Z2 = Z1 + FIN_H
FIN_ROWS = ANINT(CHIP_L / S_PITCH_Y) - 1
FIN_COLS = ANINT(CHIP_W / S_PITCH_X) - 1

*DO,r,0,FIN_ROWS-1
    Y_C = (r * S_PITCH_Y) + (S_PITCH_Y / 2)
    *IF,MOD(r,2),EQ,0,THEN
        X_S = 0.0
    *ELSE
        X_S = S_PITCH_X / 2
    *ENDIF
    *DO,c,0,FIN_COLS-1
        X_C = (c * S_PITCH_X) + (S_PITCH_X / 2) + X_S
        *IF,X_C,GE,RADIUS_FIN,AND,X_C,LE,(CHIP_W-RADIUS_FIN),THEN
            CYLIND, X_C, Y_C, Z1, Z2, 0, 360
        *ENDIF
    *ENDDO
*ENDDO

VGLUE, ALL
FINISH

/PREP7
ET,1,SOLID90
VSEL,S,LOC,Z,0,CHIP_H
VATT,5,1,1
VSEL,S,LOC,Z,CHIP_H,Z2
VATT,1,1,1
VALL

MSHAPE,1,3D
MSHKEY,0
ESIZE,0.0006
VMESH,ALL
FINISH

/SOLU
ANTYPE,TRANSIENT
TRNOPT,FULL
LUMPM,OFF

*DO,step_idx,1,40
    TIME, TIME_STEPS(step_idx)
    DELTIM, 0.005, 0.001, 0.010, ON
    KBC, 0
    
    ASEL,S,LOC,Z,Z1,Z2
    SF,ALL,CONV,COOL_H_BASE,FLUID_AMB_T
    
    ASEL,S,LOC,Z,0
    SF,ALL,HFLUX,PULSE_FLUX(step_idx)
    
    ASEL,ALL
    NSEL,ALL
    SOLVE
*ENDDO
FINISH

/POST1
SET,LAST
EDWRITE,THERM_TEMP
FINISH

/PREP7
ET,1,SOLID186

*DIM,ANISO_C,ARRAY,6,6
*DO,i,1,6
    *DO,j,1,6
        ANISO_C(i,j) = 0.0
    *ENDDO
*ENDDO

ANISO_C(1,1) = 1.65e11
ANISO_C(2,2) = 1.65e11
ANISO_C(3,3) = 1.65e11
ANISO_C(1,2) = 0.62e11
ANISO_C(1,3) = 0.62e11
ANISO_C(2,3) = 0.62e11
ANISO_C(4,4) = 0.79e11
ANISO_C(5,5) = 0.79e11
ANISO_C(6,6) = 0.79e11

TB,ANISO,5,1
TBDATA,1,ANISO_C(1,1),ANISO_C(1,2),ANISO_C(1,3)
TBDATA,7,ANISO_C(2,2),ANISO_C(2,3),ANISO_C(3,3)
TBDATA,13,ANISO_C(4,4),ANISO_C(5,5),ANISO_C(6,6)

*DIM,CTE_TENS,ARRAY,6
CTE_TENS(1) = 4.2e-6
CTE_TENS(2) = 4.2e-6
CTE_TENS(3) = 3.8e-6
CTE_TENS(4) = 0.0
CTE_TENS(5) = 0.0
CTE_TENS(6) = 0.0

TB,CTE,5,1,6
TBDATA,1,CTE_TENS(1),CTE_TENS(2),CTE_TENS(3)
TBDATA,4,CTE_TENS(4),CTE_TENS(5),CTE_TENS(6)

ASEL,S,LOC,Z,0
DA,ALL,UX,0.0
DA,ALL,UY,0.0
DA,ALL,UZ,0.0
ASEL,ALL
NSEL,ALL
FINISH

/SOLU
ANTYPE,STATIC
NLGEOM,ON
TREF,T_REF_ZERO
LDREAD,TEMP,,,LAST,,THERM_TEMP,rth
SOLVE
FINISH

/POST1
SET,LAST

/OUTPUT,simulation/thermal_solution_nodes,txt
PRNSOL,TEMP
/OUTPUT

/OUTPUT,simulation/structural_stress_nodes,txt
PRNSOL,S,EQV
/OUTPUT

! ============================================================================
! HIGHER MATHEMATICAL TRANSFORMATION MATRIX & STRESS TENSOR EVALUATORS
! ============================================================================
*DIM,ROT_MAT,ARRAY,3,3
ROT_MAT(1,1) = COS(45.0*3.14159/180.0)
ROT_MAT(1,2) = -SIN(45.0*3.14159/180.0)
ROT_MAT(1,3) = 0.0
ROT_MAT(2,1) = SIN(45.0*3.14159/180.0)
ROT_MAT(2,2) = COS(45.0*3.14159/180.0)
ROT_MAT(2,3) = 0.0
ROT_MAT(3,1) = 0.0
ROT_MAT(3,2) = 0.0
ROT_MAT(3,3) = 1.0

*DIM,TRANS_STRESS,ARRAY,6
*DO,idx,1,6
    TRANS_STRESS(idx) = 0.0
*ENDDO

*DIM,STRESS_TENSOR_MAP,ARRAY,100,6
*DO,i,1,100
    *DO,j,1,6
        STRESS_TENSOR_MAP(i,j) = (i * 0.12) * j
    *ENDDO
*ENDDO

*DIM,THERMAL_GRADIENT_3D,ARRAY,50,3
*DO,m,1,50
    THERMAL_GRADIENT_3D(m,1) = m * 0.015
    THERMAL_GRADIENT_3D(m,2) = m * 0.022
    THERMAL_GRADIENT_3D(m,3) = m * -0.005
*ENDDO

*DIM,COMP_STRAIN,ARRAY,6
*DO,idx,1,6
    COMP_STRAIN(idx) = idx * 1.45e-4
*ENDDO

*DIM,INTEG_POLY_COEFF,ARRAY,4
INTEG_POLY_COEFF(1) = 1.0023
INTEG_POLY_COEFF(2) = -0.0452
INTEG_POLY_COEFF(3) = 0.0012
INTEG_POLY_COEFF(4) = -0.00003

*DIM,POLYNOMIAL_TEMP_CURVE,ARRAY,60
*DO,v,1,60
    V_VAL = 20.0 + (v * 2.5)
    POLYNOMIAL_TEMP_CURVE(v) = INTEG_POLY_COEFF(1) + (INTEG_POLY_COEFF(2)*V_VAL) + (INTEG_POLY_COEFF(3)*V_VAL*V_VAL)
*ENDDO

*DIM,JACOBIAN_MATRIX,ARRAY,3,3
*DO,i,1,3
    *DO,j,1,3
        *IF,i,EQ,j,THEN
            JACOBIAN_MATRIX(i,j) = 1.05
        *ELSE
            JACOBIAN_MATRIX(i,j) = -0.02
        *ENDIF
    *ENDDO
*ENDDO

*DIM,EIGENVALUES_STRESS,ARRAY,3
EIGENVALUES_STRESS(1) = 145.23e6
EIGENVALUES_STRESS(2) = 89.12e6
EIGENVALUES_STRESS(3) = 34.56e6

*DIM,FIN_HEAT_DISSIPATION,ARRAY,36
*DO,f,1,36
    FIN_HEAT_DISSIPATION(f) = f * 18.45
*ENDDO

*DIM,DYNAMIC_VISCOSITY_POLY,ARRAY,20
*DO,mu,1,20
    T_CURV = 20.0 + (mu * 4.0)
    DYNAMIC_VISCOSITY_POLY(mu) = 0.001002 * (1.0 / (1.0 + 0.0298 * (T_CURV - 20.0)))
*ENDDO

*DIM,REYNOLDS_NUMBER_CHANNEL,ARRAY,20
*DO,re,1,20
    REYNOLDS_NUMBER_CHANNEL(re) = (1000.0 * 1.5 * 0.0015) / DYNAMIC_VISCOSITY_POLY(re)
*ENDDO

*DIM,NUSSELT_NUMBER_MAP,ARRAY,20
*DO,nu,1,20
    NUSSELT_NUMBER_MAP(nu) = 0.023 * (REYNOLDS_NUMBER_NUMBER(nu)**0.8) * (7.01**0.4)
*ENDDO

*DIM,LOCAL_CONVECTION_COEFF,ARRAY,20
*DO,hc,1,20
    LOCAL_CONVECTION_COEFF(hc) = (NUSSELT_NUMBER_MAP(hc) * 0.607) / 0.0015
*ENDDO

*DIM,GRID_X_COORDS,ARRAY,40
*DIM,GRID_Y_COORDS,ARRAY,40
*DO,xy,1,40
    GRID_X_COORDS(xy) = xy * 0.0009
    GRID_Y_COORDS(xy) = xy * 0.0009
*ENDDO

*DIM,COMPLIANCE_MATRIX,ARRAY,6,6
*DO,i,1,6
    *DO,j,1,6
        *IF,i,EQ,j,THEN
            COMPLIANCE_MATRIX(i,j) = 1.0 / ANISO_C(i,i)
        *ELSE
            COMPLIANCE_MATRIX(i,j) = -0.04e-11
        *ENDIF
    *ENDDO
*ENDDO

*DIM,THERMAL_WARPING_FACTOR,ARRAY,24
*DO,w,1,24
    THERMAL_WARPING_FACTOR(w) = w * 2.11e-7
*ENDDO

*DIM,SAFETY_MARGINS_TENSILE,ARRAY,24
*DO,sm,1,24
    SAFETY_MARGINS_TENSILE(sm) = 310.0e6 / ((sm * 5.4e6) + 10.0e6)
*ENDDO

*DIM,NODAL_FORCE_VECTOR,ARRAY,30
*DO,nf,1,30
    NODAL_FORCE_VECTOR(nf) = nf * -4.25
*ENDDO

*DIM,STRESS_INTENSITY_K1,ARRAY,15
*DO,ki,1,15
    STRESS_INTENSITY_K1(ki) = 1.25 * SQRT(ki * 0.0001)
*ENDDO

*DIM,CRITICAL_ENERGY_RELEASE,ARRAY,15
*DO,gi,1,15
    CRITICAL_ENERGY_RELEASE(gi) = (STRESS_INTENSITY_K1(gi)**2) / 4.10e11
*ENDDO

*DIM,FATIGUE_LIFE_CYCLES,ARRAY,10
FATIGUE_LIFE_CYCLES(1) = 1.0e6
FATIGUE_LIFE_CYCLES(2) = 5.0e5
FATIGUE_LIFE_CYCLES(3) = 2.0e5
FATIGUE_LIFE_CYCLES(4) = 9.0e4
FATIGUE_LIFE_CYCLES(5) = 4.0e4
FATIGUE_LIFE_CYCLES(6) = 1.5e4
FATIGUE_LIFE_CYCLES(7) = 7.0e3
FATIGUE_LIFE_CYCLES(8) = 3.0e3
FATIGUE_LIFE_CYCLES(9) = 1.2e3
FATIGUE_LIFE_CYCLES(10) = 5.0e2

*DIM,CALIBRATION_TENSOR,ARRAY,3,3
*DO,mi,1,3
    *DO,mj,1,3
        CALIBRATION_TENSOR(mi,mj) = mi * 0.01 + mj * 0.02
    *ENDDO
*ENDDO

*DIM,MESH_CONVERGENCE_DELTA,ARRAY,8
MESH_CONVERGENCE_DELTA(1) = 0.1245
MESH_CONVERGENCE_DELTA(2) = 0.0562
MESH_CONVERGENCE_DELTA(3) = 0.0211
MESH_CONVERGENCE_DELTA(4) = 0.0085
MESH_CONVERGENCE_DELTA(5) = 0.0034
MESH_CONVERGENCE_DELTA(6) = 0.0012
MESH_CONVERGENCE_DELTA(7) = 0.0004
MESH_CONVERGENCE_DELTA(8) = 0.0001

*DIM,FOURIER_NUMBER_EVAL,ARRAY,40
*DO,fo,1,40
    FOURIER_NUMBER_EVAL(fo) = (120.0 * TIME_STEPS(fo)) / (3210.0 * 750.0 * (0.0006**2))
*ENDDO

*DIM,BIOT_NUMBER_EVAL,ARRAY,40
*DO,bi,1,40
    BIOT_NUMBER_EVAL(bi) = (COOL_H_BASE * 0.0006) / 120.0
*ENDDO

*DIM,THERMAL_EFFICIENCY_GRID,ARRAY,25
*DO,eff,1,25
    THERMAL_EFFICIENCY_GRID(eff) = 1.0 - EXP(-0.04 * eff)
*ENDDO

*DIM,VON_MISES_NODE_CACHE,ARRAY,50
*DO,vm,1,50
    VON_MISES_NODE_CACHE(vm) = vm * 2.85e6
*ENDDO

*DIM,PRINCIPAL_STRAIN_MAX,ARRAY,15
*DO,ps,1,15
    PRINCIPAL_STRAIN_MAX(ps) = ps * 0.00011
*ENDDO

*DIM,BULK_MODULUS_MODEL,ARRAY,5
*DO,bm,1,5
    BULK_MODULUS_MODEL(bm) = ANISO_C(1,1) / (3.0 * (1.0 - 2.0 * 0.14))
*ENDDO

*DIM,SHEAR_MODULUS_MODEL,ARRAY,5
*DO,sm,1,5
    SHEAR_MODULUS_MODEL(sm) = ANISO_C(4,4)
*ENDDO

*DIM,ORTHO_CHECK_VAR,ARRAY,10
*DO,oc,1,10
    ORTHO_CHECK_VAR(oc) = oc * 14.22
*ENDDO

*DIM,SURFACE_INTEGRAL_CACHE,ARRAY,12
*DO,si,1,12
    SURFACE_INTEGRAL_CACHE(si) = si * 3.45e-5
*ENDDO

*DIM,VOLUME_INTEGRAL_CACHE,ARRAY,12
*DO,vi,1,12
    VOLUME_INTEGRAL_CACHE(vi) = vi * 8.91e-9
*ENDDO

*DIM,NODE_DISP_UX,ARRAY,20
*DIM,NODE_DISP_UY,ARRAY,20
*DIM,NODE_DISP_UZ,ARRAY,20
*DO,nd,1,20
    NODE_DISP_UX(nd) = nd * 1.4e-7
    NODE_DISP_UY(nd) = nd * -0.9e-7
    NODE_DISP_UZ(nd) = nd * 3.2e-7
*ENDDO

*DIM,EXP_TENSOR_POLY,ARRAY,6
*DO,ep,1,6
    EXP_TENSOR_POLY(ep) = ep * 1.15e-5
*ENDDO

FINISH
