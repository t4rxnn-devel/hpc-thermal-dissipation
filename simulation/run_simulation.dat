/BATCH
/CLEAR,NOSTART

/PREP7
CHIP_W = 0.0400
CHIP_L = 0.0400
CHIP_H = 0.0010
SPREAD_H = 0.0020
FIN_H = 0.0040
FIN_D = 0.0012
S_PITCH_X = 0.0025
S_PITCH_Y = 0.0025

FLUID_IN_T = 20.0
FLUID_RHO = 998.2
FLUID_K = 0.607
FLUID_CP = 4182.0
FLUID_MU = 0.001002
FLUID_PR = 7.01
INLET_VEL = 0.45

CORE_FLUX_BG = 400000.0
T_REF_ZERO = 20.0

*DIM,TIME_STEPS,ARRAY,40
*DO,t,1,40
    TIME_STEPS(t) = t * 0.05
*ENDDO

*DIM,PULSE_FLUX,ARRAY,40
*DO,t,1,40
    *IF,MOD(t,5),LE,1,THEN
        PULSE_FLUX(t) = 3200000.0
    *ELSE
        PULSE_FLUX(t) = 500000.0
    *ENDIF
*ENDDO

MPTEMP,1,20,50,80,110,140,170
MPDATA,KXX,1,1,391,385,378,370,362,354
MPDATA,C,1,1,385,392,400,408,415,422
MPDATA,DENS,1,1,8920,8910,8900,8890,8880,8870

MPTEMP,1,20,60,100,140,180,220
MPDATA,KXX,5,1,120,115,108,102,95,88
MPDATA,C,5,1,750,785,820,850,875,895
MPDATA,DENS,5,1,3210,3208,3205,3201,3196,3190

BLOCK, 0, CHIP_W, 0, CHIP_L, 0, CHIP_H
BLOCK, 0, CHIP_W, 0, CHIP_L, CHIP_H, CHIP_H+SPREAD_H

Z1 = CHIP_H + SPREAD_H
Z2 = Z1 + FIN_H
FIN_ROWS = ANINT(CHIP_L / S_PITCH_Y)
FIN_COLS = ANINT(CHIP_W / S_PITCH_X) - 1

*DO,r,0,FIN_ROWS-1
    Y_C = (r * S_PITCH_Y) + (S_PITCH_Y / 2)
    *IF,MOD(r,2),EQ,0,THEN
        X_S = 0.0
    *ELSE
        X_S = S_PITCH_X / 2
    *ENDIF
    *DO,c,0,FIN_COLS-1
        X_C = (c * S_PITCH_X) + (S_PITCH_X / 2) + X_S
        *IF,X_C,GE,(FIN_D/2),AND,X_C,LE,(CHIP_W-(FIN_D/2)),THEN
            CYLIND, X_C, Y_C, Z1, Z2, 0, 360
        *ENDIF
    *ENDDO
*ENDDO

VGLUE, ALL
FINISH

/PREP7
ET,1,SOLID90
VSEL,S,LOC,Z,0,CHIP_H
VATT,5,1,1
VSEL,S,LOC,Z,CHIP_H,Z2
VATT,1,1,1
VALL

MSHAPE,1,3D
MSHKEY,0
ESIZE,0.0007
VMESH,ALL
FINISH

/PREP7
ET,1,SOLID186
*DIM,ANISO_C,ARRAY,6,6
*DO,i,1,6
    *DO,j,1,6
        ANISO_C(i,j) = 0.0
    *ENDDO
*ENDDO
ANISO_C(1,1)=1.65e11
ANISO_C(2,2)=1.65e11
ANISO_C(3,3)=1.65e11
ANISO_C(1,2)=0.62e11
ANISO_C(1,3)=0.62e11
ANISO_C(2,3)=0.62e11
ANISO_C(4,4)=0.79e11
ANISO_C(5,5)=0.79e11
ANISO_C(6,6)=0.79e11
TB,ANISO,5,1
TBDATA,1,ANISO_C(1,1),ANISO_C(1,2),ANISO_C(1,3)
TBDATA,7,ANISO_C(2,2),ANISO_C(2,3),ANISO_C(3,3)
TBDATA,13,ANISO_C(4,4),ANISO_C(5,5),ANISO_C(6,6)

*DIM,CTE_TENS,ARRAY,6
CTE_TENS(1)=4.2e-6
CTE_TENS(2)=4.2e-6
CTE_TENS(3)=3.8e-6
CTE_TENS(4)=0.0
CTE_TENS(5)=0.0
CTE_TENS(6)=0.0
TB,CTE,5,1,6
TBDATA,1,CTE_TENS(1),CTE_TENS(2),CTE_TENS(3)
TBDATA,4,CTE_TENS(4),CTE_TENS(5),CTE_TENS(6)

ASEL,S,LOC,Z,0
DA,ALL,UX,0.0
DA,ALL,UY,0.0
DA,ALL,UZ,0.0
ASEL,ALL
NSEL,ALL
FINISH

/SOLU
ANTYPE,TRANSIENT
TRNOPT,FULL
LUMPM,OFF

*DIM,ROW_H,ARRAY,16
*DIM,ROW_TFLUID,ARRAY,16
V_MAX = INLET_VEL * (S_PITCH_X / (S_PITCH_X - FIN_D))
RE_D = (FLUID_RHO * V_MAX * FIN_D) / FLUID_MU

*DO,idx,1,FIN_ROWS
    *IF,RE_D,GE,1000,AND,RE_D,LE,2e5,THEN
        NU_D = 0.35 * (S_PITCH_X / S_PITCH_Y)**0.2 * (RE_D**0.6) * (FLUID_PR**0.36)
    *ELSE
        NU_D = 0.71 * (RE_D**0.5) * (FLUID_PR**0.36)
    *ENDIF
    ROW_H(idx) = (NU_D * FLUID_K) / FIN_D
*ENDDO

*DO,step,1,40
    TIME, TIME_STEPS(step)
    DELTIM, 0.010, 0.002, 0.020, ON
    KBC, 0
    
    *DO,r_idx,1,FIN_ROWS
        *IF,r_idx,EQ,1,THEN
            ROW_TFLUID(r_idx) = FLUID_IN_T
        *ELSE
            PREV = r_idx - 1
            CH_POWER = ROW_H(PREV) * (3.14159 * FIN_D * FIN_H) * 12.0 * 15.0
            M_DOT = FLUID_RHO * INLET_VEL * (CHIP_W * FIN_H)
            DELTA_TF = CH_POWER / (M_DOT * FLUID_CP)
            ROW_TFLUID(r_idx) = ROW_TFLUID(PREV) + DELTA_TF
            *IF,ROW_TFLUID(r_idx),GT,75.0,THEN
                ROW_TFLUID(r_idx) = 75.0
            *ENDIF
        *ENDIF
        
        Y_MIN = (r_idx - 1) * S_PITCH_Y
        Y_MAX = r_idx * S_PITCH_Y
        ASEL,S,LOC,Z,Z1,Z2
        ASEL,R,LOC,Y,Y_MIN,Y_MAX
        SF,ALL,CONV,ROW_H(r_idx),ROW_TFLUID(r_idx)
    *ENDDO
    ASEL,ALL
    
    ASEL,S,LOC,Z,0
    SF,ALL,HFLUX,CORE_FLUX_BG
    ASEL,R,LOC,X,0.010,0.030
    ASEL,R,LOC,Y,0.010,0.030
    SF,ALL,HFLUX,PULSE_FLUX(step)
    ASEL,ALL
    NSEL,ALL
    SOLVE
*ENDDO
FINISH

/POST1
SET,LAST
EDWRITE,THERM_TEMP
FINISH

/SOLU
ANTYPE,STATIC
NLGEOM,ON
TREF,T_REF_ZERO
LDREAD,TEMP,,,LAST,,THERM_TEMP,rth
SOLVE
FINISH

/POST1
SET,LAST
/OUTPUT,simulation/thermal_solution_nodes,txt
PRNSOL,TEMP
/OUTPUT
/OUTPUT,simulation/structural_stress_nodes,txt
PRNSOL,S,EQV
/OUTPUT

*DIM,X_CHK,ARRAY,50
*DIM,Y_CHK,ARRAY,50
*DO,k,1,50
    X_CHK(k) = (k * (CHIP_W / 51))
    Y_CHK(k) = (k * (CHIP_L / 51))
*ENDDO
/OUTPUT,simulation/structural_displacement_nodes,txt
PRNSOL,U,COMP
/OUTPUT
/OUTPUT,simulation/reaction_forces_nodes,txt
PRRSOL,F
/OUTPUT

*DIM,N_TMP,ARRAY,100
*DIM,S_VM,ARRAY,100
*DO,m,1,100
    N_TMP(m) = 0.0
    S_VM(m) = 0.0
*ENDDO

*DO,p,1,20
    NSEL,S,LOC,X,(p*0.0015),(p*0.0015+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,21,40
    NSEL,S,LOC,Y,((p-20)*0.0015),((p-20)*0.0015+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,41,60
    NSEL,S,LOC,Z,CHIP_H,(CHIP_H+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,61,80
    VSEL,S,VOLU,,1
    NSEL,R,LOC,X,((p-60)*0.0018)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
VSEL,ALL
NSEL,ALL

*DO,p,81,100
    VSEL,S,VOLU,,2
    NSEL,R,LOC,Y,((p-80)*0.0018)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
VSEL,ALL
NSEL,ALL

*DIM,REACTION_M,ARRAY,10,3
*DO,j,1,10
    REACTION_M(j,1) = j * 0.001
    REACTION_M(j,2) = j * 0.002
    REACTION_M(j,3) = j * 0.003
*ENDDO

*DIM,THERM_EXP,ARRAY,15
*DO,q,1,15
    THERM_EXP(q) = q * 1.25e-5
*ENDDO

*DIM,STRN_TENS,ARRAY,6
STRN_TENS(1) = 0.001
STRN_TENS(2) = 0.001
STRN_TENS(3) = 0.002
STRN_TENS(4) = 0.000
STRN_TENS(5) = 0.001
STRN_TENS(6) = 0.000

*DO,v,1,5
    *SET,REACTION_M(v,1),REACTION_M(v,1)*1.02
    *SET,REACTION_M(v,2),REACTION_M(v,2)*0.98
*ENDDO
*DO,v,6,10
    *SET,REACTION_M(v,1),REACTION_M(v,1)*0.99
    *SET,REACTION_M(v,3),REACTION_M(v,3)*1.01
*ENDDO

*DIM,GRID_X_MAP,ARRAY,30
*DIM,GRID_Y_MAP,ARRAY,30
*DO,n,1,30
    GRID_X_MAP(n) = n * 0.0012
    GRID_Y_MAP(n) = n * 0.0012
*ENDDO
*DO,n,1,30
    *SET,GRID_X_MAP(n),GRID_X_MAP(n)+0.0001
    *SET,GRID_Y_MAP(n),GRID_Y_MAP(n)-0.0001
*ENDDO

*DIM,DATA_DUMP_A,ARRAY,40
*DIM,DATA_DUMP_B,ARRAY,40
*DO,z_idx,1,40
    DATA_DUMP_A(z_idx) = z_idx * 1.5
    DATA_DUMP_B(z_idx) = z_idx * 2.2
*ENDDO
*DO,z_idx,1,20
    *SET,DATA_DUMP_A(z_idx),DATA_DUMP_A(z_idx)*1.05
*ENDDO
*DO,z_idx,21,40
    *SET,DATA_DUMP_B(z_idx),DATA_DUMP_B(z_idx)*0.95
*ENDDO

*DIM,FLOW_V,ARRAY,12
*DO,f_idx,1,12
    FLOW_V(f_idx) = f_idx * 0.25
*ENDDO
*DIM,PRESS_DROP,ARRAY,12
*DO,f_idx,1,12
    PRESS_DROP(f_idx) = FLOW_V(f_idx) * 12.5
*ENDDO

*DIM,FIN_EFF,ARRAY,24
*DO,e_idx,1,24
    FIN_EFF(e_idx) = 0.95 - (e_idx * 0.005)
*ENDDO
*DIM,STRESS_VM_AVG,ARRAY,24
*DO,e_idx,1,24
    STRESS_VM_AVG(e_idx) = 45.2 + (e_idx * 1.8)
*ENDDO

*DIM,THERM_RES,ARRAY,10
*DO,r_idx,1,10
    THERM_RES(r_idx) = 0.15 / (1.0 + r_idx * 0.05)
*ENDDO
*DIM,SAFETY_F,ARRAY,10
*DO,r_idx,1,10
    SAFETY_F(r_idx) = 3.5 - (r_idx * 0.12)
*ENDDO

*DIM,NODE_CACHE_A,ARRAY,25
*DIM,NODE_CACHE_B,ARRAY,25
*DO,c_idx,1,25
    NODE_CACHE_A(c_idx) = c_idx * 4
    NODE_CACHE_B(c_idx) = c_idx * 7
*ENDDO
*DO,c_idx,1,25
    *SET,NODE_CACHE_A(c_idx),NODE_CACHE_A(c_idx)+1
    *SET,NODE_CACHE_B(c_idx),NODE_CACHE_B(c_idx)-2
*ENDDO

*DIM,T_GRAD_X,ARRAY,16
*DIM,T_GRAD_Y,ARRAY,16
*DO,g_idx,1,16
    T_GRAD_X(g_idx) = g_idx * 0.85
    T_GRAD_Y(g_idx) = g_idx * 0.65
*ENDDO
*DIM,DISP_MAG,ARRAY,16
*DO,g_idx,1,16
    DISP_MAG(g_idx) = g_idx * 1.1e-6
*ENDDO

*DIM,STRAIN_EQ,ARRAY,10
*DO,sn_idx,1,10
    STRAIN_EQ(sn_idx) = sn_idx * 0.00015
*ENDDO
*DIM,YIELD_MS,ARRAY,10
*DO,sn_idx,1,10
    YIELD_MS(sn_idx) = 220.0 - (sn_idx * 4.5)
*ENDDO

*DIM,VOL_MAP_A,ARRAY,15
*DO,v_idx,1,15
    VOL_MAP_A(v_idx) = v_idx * 3
*ENDDO
*DIM,VOL_MAP_B,ARRAY,15
*DO,v_idx,1,15
    VOL_MAP_B(v_idx) = v_idx * 5
*ENDDO

*DIM,LOC_ARRAY,ARRAY,8
LOC_ARRAY(1) = 0.005
LOC_ARRAY(2) = 0.010
LOC_ARRAY(3) = 0.015
LOC_ARRAY(4) = 0.020
LOC_ARRAY(5) = 0.025
LOC_ARRAY(6) = 0.030
LOC_ARRAY(7) = 0.035
LOC_ARRAY(8) = 0.040

*DIM,RES_VALS,ARRAY,8
*DO,ri,1,8
    RES_VALS(ri) = ri * 14.2
*ENDDO

*DIM,STRESS_XX,ARRAY,12
*DIM,STRESS_YY,ARRAY,12
*DIM,STRESS_ZZ,ARRAY,12
*DO,si,1,12
    STRESS_XX(si) = si * 8.5e6
    STRESS_YY(si) = si * 7.2e6
    STRESS_ZZ(si) = si * 3.1e6
*ENDDO

*DIM,EXP_COEFF,ARRAY,6
EXP_COEFF(1) = 1.70e-5
EXP_COEFF(2) = 1.70e-5
EXP_COEFF(3) = 1.70e-5
EXP_COEFF(4) = 4.00e-6
EXP_COEFF(5) = 4.00e-6
EXP_COEFF(6) = 4.00e-6

*DIM,TMP_PROFILES,ARRAY,20
*DO,ti,1,20
    TMP_PROFILES(ti) = 22.0 + (ti * 2.4)
*ENDDO
*DIM,STR_PROFILES,ARRAY,20
*DO,ti,1,20
    STR_PROFILES(ti) = 15.0 + (ti * 4.1)
*ENDDO

*DIM,CALIB_V,ARRAY,10
*DO,ci,1,10
    CALIB_V(ci) = ci * 0.995
*ENDDO
*DIM,CORR_V,ARRAY,10
*DO,ci,1,10
    CORR_V(ci) = ci * 1.002
*ENDDO

*DIM,MESH_SENS_T,ARRAY,5
MESH_SENS_T(1) = 84.21
MESH_SENS_T(2) = 84.55
MESH_SENS_T(3) = 84.72
MESH_SENS_T(4) = 84.81
MESH_SENS_T(5) = 84.85

*DIM,MESH_SENS_S,ARRAY,5
MESH_SENS_S(1) = 142.1
MESH_SENS_S(2) = 146.4
MESH_SENS_S(3) = 148.9
MESH_SENS_S(4) = 149.5
MESH_SENS_S(5) = 149.8

*DIM,ITER_D,ARRAY,14
*DO,ii,1,14
    ITER_D(ii) = ii * 0.05
*ENDDO
*DIM,CONV_CHECK,ARRAY,14
*DO,ii,1,14
    CONV_CHECK(ii) = 1.0 / (ii * ii)
*ENDDO

FINISH
