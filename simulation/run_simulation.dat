/BATCH
/CLEAR,NOSTART

/PREP7
CHIP_W = 0.0400
CHIP_L = 0.0400
CHIP_H = 0.0010
SPREAD_H = 0.0020
FIN_H = 0.0040
FIN_D = 0.0012
S_PITCH_X = 0.0025
S_PITCH_Y = 0.0025

FLUID_IN_T = 20.0
FLUID_RHO = 998.2
FLUID_K = 0.607
FLUID_CP = 4182.0
FLUID_MU = 0.001002
FLUID_PR = 7.01
INLET_VEL = 0.45

CORE_FLUX_BG = 400000.0
T_REF_ZERO = 20.0

*DIM,TIME_STEPS,ARRAY,40
*DO,t,1,40
    TIME_STEPS(t) = t * 0.05
*ENDDO

*DIM,PULSE_FLUX,ARRAY,40
*DO,t,1,40
    *IF,MOD(t,5),LE,1,THEN
        PULSE_FLUX(t) = 3200000.0
    *ELSE
        PULSE_FLUX(t) = 500000.0
    *ENDIF
*ENDDO

! ============================================================================
! MATERIAL PROPERTY MATRIX: TEMPERATURE-DEPENDENT POLYNOMIAL CURVES
! ============================================================================
MPTEMP,1,20.0,50.0,80.0,110.0,140.0,170.0
MPDATA,KXX,1,1,391.0,385.0,378.0,370.0,362.0,354.0
MPDATA,KYY,1,1,391.0,385.0,378.0,370.0,362.0,354.0
MPDATA,KZZ,1,1,391.0,385.0,378.0,370.0,362.0,354.0
MPDATA,C,1,1,385.0,392.0,400.0,408.0,415.0,422.0
MPDATA,DENS,1,1,8920.0,8910.0,8900.0,8890.0,8880.0,8870.0

MPTEMP,1,20.0,60.0,100.0,140.0,180.0,220.0
MPDATA,KXX,5,1,120.0,115.0,108.0,102.0,95.0,88.0
MPDATA,KYY,5,1,120.0,115.0,108.0,102.0,95.0,88.0
MPDATA,KZZ,5,1,120.0,115.0,108.0,102.0,95.0,88.0
MPDATA,C,5,1,750.0,785.0,820.0,850.0,875.0,895.0
MPDATA,DENS,5,1,3210.0,3208.0,3205.0,3201.0,3196.0,3190.0

MPTEMP,1,20.0,70.0,120.0,170.0,220.0,270.0
MPDATA,ALPX,1,1,1.70e-5,1.72e-5,1.75e-5,1.78e-5,1.81e-5,1.84e-5
MPDATA,ALPX,5,1,4.00e-6,4.10e-6,4.22e-6,4.35e-6,4.48e-6,4.60e-6
MPDATA,EX,1,1,1.15e11,1.12e11,1.09e11,1.06e11,1.03e11,1.00e11
MPDATA,EX,5,1,4.10e11,4.05e11,3.98e11,3.90e11,3.82e11,3.75e11

BLOCK, 0, CHIP_W, 0, CHIP_L, 0, CHIP_H
BLOCK, 0, CHIP_W, 0, CHIP_L, CHIP_H, CHIP_H+SPREAD_H

Z1 = CHIP_H + SPREAD_H
Z2 = Z1 + FIN_H
FIN_ROWS = ANINT(CHIP_L / S_PITCH_Y)
FIN_COLS = ANINT(CHIP_W / S_PITCH_X) - 1

*DO,r,0,FIN_ROWS-1
    Y_C = (r * S_PITCH_Y) + (S_PITCH_Y / 2)
    *IF,MOD(r,2),EQ,0,THEN
        X_S = 0.0
    *ELSE
        X_S = S_PITCH_X / 2
    *ENDIF
    *DO,c,0,FIN_COLS-1
        X_C = (c * S_PITCH_X) + (S_PITCH_X / 2) + X_S
        *IF,X_C,GE,(FIN_D/2),AND,X_C,LE,(CHIP_W-(FIN_D/2)),THEN
            CYLIND, X_C, Y_C, Z1, Z2, 0, 360
        *ENDIF
    *ENDDO
*ENDDO

VGLUE, ALL
FINISH

! ============================================================================
! ADVANCED MESH REFINEMENT AND INTERFACE BIASING LOOP
! ============================================================================
/PREP7
ET,1,SOLID90
VSEL,S,LOC,Z,0,CHIP_H
VATT,5,1,1
VSEL,S,LOC,Z,CHIP_H,Z2
VATT,1,1,1
VALL

MSHAPE,1,3D
MSHKEY,0
ESIZE,0.0007

LSEL,S,LOC,Z,Z1,Z2
LESIZE,ALL,,,8,4.0
LSEL,S,LOC,Z,CHIP_H,Z1
LESIZE,ALL,0.0005
LSEL,S,LOC,Z,0,CHIP_H
LESIZE,ALL,0.0003
LSEL,ALL

VMESH,ALL

*GET,V_COUNT,VOLU,0,COUNT
*GET,E_COUNT,ELEM,0,COUNT
*GET,N_COUNT,NODE,0,COUNT
*IF,E_COUNT,LT,5000,THEN
    REFV,ALL___
*ENDIF
FINISH

/PREP7
ET,1,SOLID186
*DIM,ANISO_C,ARRAY,6,6
*DO,i,1,6
    *DO,j,1,6
        ANISO_C(i,j) = 0.0
    *ENDDO
*ENDDO
ANISO_C(1,1)=1.65e11
ANISO_C(2,2)=1.65e11
ANISO_C(3,3)=1.65e11
ANISO_C(1,2)=0.62e11
ANISO_C(1,3)=0.62e11
ANISO_C(2,3)=0.62e11
ANISO_C(4,4)=0.79e11
ANISO_C(5,5)=0.79e11
ANISO_C(6,6)=0.79e11
TB,ANISO,5,1
TBDATA,1,ANISO_C(1,1),ANISO_C(1,2),ANISO_C(1,3)
TBDATA,7,ANISO_C(2,2),ANISO_C(2,3),ANISO_C(3,3)
TBDATA,13,ANISO_C(4,4),ANISO_C(5,5),ANISO_C(6,6)

*DIM,CTE_TENS,ARRAY,6
CTE_TENS(1)=4.2e-6
CTE_TENS(2)=4.2e-6
CTE_TENS(3)=3.8e-6
CTE_TENS(4)=0.0
CTE_TENS(5)=0.0
CTE_TENS(6)=0.0
TB,CTE,5,1,6
TBDATA,1,CTE_TENS(1),CTE_TENS(2),CTE_TENS(3)
TBDATA,4,CTE_TENS(4),CTE_TENS(5),CTE_TENS(6)

ASEL,S,LOC,Z,0
DA,ALL,UX,0.0
DA,ALL,UY,0.0
DA,ALL,UZ,0.0
ASEL,ALL
NSEL,ALL
FINISH

/SOLU
ANTYPE,TRANSIENT
TRNOPT,FULL
LUMPM,OFF

*DIM,ROW_H,ARRAY,16
*DIM,ROW_TFLUID,ARRAY,16
V_MAX = INLET_VEL * (S_PITCH_X / (S_PITCH_X - FIN_D))
RE_D = (FLUID_RHO * V_MAX * FIN_D) / FLUID_MU

*DO,idx,1,FIN_ROWS
    *IF,RE_D,GE,1000,AND,RE_D,LE,2e5,THEN
        NU_D = 0.35 * (S_PITCH_X / S_PITCH_Y)**0.2 * (RE_D**0.6) * (FLUID_PR**0.36)
    *ELSE
        NU_D = 0.71 * (RE_D**0.5) * (FLUID_PR**0.36)
    *ENDIF
    ROW_H(idx) = (NU_D * FLUID_K) / FIN_D
*ENDDO

*DO,step,1,40
    TIME, TIME_STEPS(step)
    DELTIM, 0.010, 0.002, 0.020, ON
    KBC, 0
    
    *DO,r_idx,1,FIN_ROWS
        *IF,r_idx,EQ,1,THEN
            ROW_TFLUID(r_idx) = FLUID_IN_T
        *ELSE
            PREV = r_idx - 1
            CH_POWER = ROW_H(PREV) * (3.14159 * FIN_D * FIN_H) * 12.0 * 15.0
            M_DOT = FLUID_RHO * INLET_VEL * (CHIP_W * FIN_H)
            DELTA_TF = CH_POWER / (M_DOT * FLUID_CP)
            ROW_TFLUID(r_idx) = ROW_TFLUID(PREV) + DELTA_TF
            *IF,ROW_TFLUID(r_idx),GT,75.0,THEN
                ROW_TFLUID(r_idx) = 75.0
            *ENDIF
        *ENDIF
        
        Y_MIN = (r_idx - 1) * S_PITCH_Y
        Y_MAX = r_idx * S_PITCH_Y
        ASEL,S,LOC,Z,Z1,Z2
        ASEL,R,LOC,Y,Y_MIN,Y_MAX
        SF,ALL,CONV,ROW_H(r_idx),ROW_TFLUID(r_idx)
    *ENDDO
    ASEL,ALL
    
    ASEL,S,LOC,Z,0
    SF,ALL,HFLUX,CORE_FLUX_BG
    ASEL,R,LOC,X,0.010,0.030
    ASEL,R,LOC,Y,0.010,0.030
    SF,ALL,HFLUX,PULSE_FLUX(step)
    ASEL,ALL
    NSEL,ALL
    SOLVE
*ENDDO
FINISH

/POST1
SET,LAST
EDWRITE,THERM_TEMP
FINISH

/SOLU
ANTYPE,STATIC
NLGEOM,ON
TREF,T_REF_ZERO
LDREAD,TEMP,,,LAST,,THERM_TEMP,rth
SOLVE
FINISH

! ============================================================================
! DETAILED POST-PROCESSING & STEPWISE TELEMETRY OUTPUT LOGGING
! ============================================================================
/POST1
*GET,MAX_N,NODE,0,NUM,MAX
*DIM,TELE_MAP_T,ARRAY,MAX_N,8
*DIM,N_COORD_X,ARRAY,MAX_N
*DIM,N_COORD_Y,ARRAY,MAX_N
*DIM,N_COORD_Z,ARRAY,MAX_N

*DO,ni,1,MAX_N
    *IF,NDNEXT(ni),NE,0,THEN
        N_COORD_X(ni) = NX(ni)
        N_COORD_Y(ni) = NY(ni)
        N_COORD_Z(ni) = NZ(ni)
    *ENDIF
*ENDDO

*DO,ti_step,5,40,5
    SET,,, ,,,ti_step
    /OUTPUT,simulation/telemetry_step_%ti_step%,txt
    
    *VWRITE,SEQUENTIAL_INDEX,N_COORD_X(1),N_COORD_Y(1),N_COORD_Z(1)
(F10.0, 3E15.6)
    
    *VWRITE,TEMP(1)
(E15.6)
    
    /OUTPUT
*ENDDO

SET,LAST
/OUTPUT,simulation/thermal_solution_nodes,txt
PRNSOL,TEMP
/OUTPUT
/OUTPUT,simulation/structural_stress_nodes,txt
PRNSOL,S,EQV
/OUTPUT

*DIM,X_CHK,ARRAY,50
*DIM,Y_CHK,ARRAY,50
*DO,k,1,50
    X_CHK(k) = (k * (CHIP_W / 51))
    Y_CHK(k) = (k * (CHIP_L / 51))
*ENDDO
/OUTPUT,simulation/structural_displacement_nodes,txt
PRNSOL,U,COMP
/OUTPUT
/OUTPUT,simulation/reaction_forces_nodes,txt
PRRSOL,F
/OUTPUT

*DIM,N_TMP,ARRAY,100
*DIM,S_VM,ARRAY,100
*DO,m,1,100
    N_TMP(m) = 0.0
    S_VM(m) = 0.0
*ENDDO

*DO,p,1,20
    NSEL,S,LOC,X,(p*0.0015),(p*0.0015+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,21,40
    NSEL,S,LOC,Y,((p-20)*0.0015),((p-20)*0.0015+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,41,60
    NSEL,S,LOC,Z,CHIP_H,(CHIP_H+0.0005)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
NSEL,ALL

*DO,p,61,80
    VSEL,S,VOLU,,1
    NSEL,R,LOC,X,((p-60)*0.0018)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
VSEL,ALL
NSEL,ALL

*DO,p,81,100
    VSEL,S,VOLU,,2
    NSEL,R,LOC,Y,((p-80)*0.0018)
    *GET,N_TMP(p),NODE,0,MAX,TEMP
    *GET,S_VM(p),NODE,0,MAX,S,EQV
*ENDDO
VSEL,ALL
NSEL,ALL

*DIM,REACTION_M,ARRAY,10,3
*DO,j,1,10
    REACTION_M(j,1) = j * 0.001
    REACTION_M(j,2) = j * 0.002
    REACTION_M(j,3) = j * 0.003
*ENDDO

*DIM,THERM_EXP,ARRAY,15
*DO,q,1,15
    THERM_EXP(q) = q * 1.25e-5
*ENDDO

*DIM,STRN_TENS,ARRAY,6
STRN_TENS(1) = 0.001
STRN_TENS(2) = 0.001
STRN_TENS(3) = 0.002
STRN_TENS(4) = 0.000
STRN_TENS(5) = 0.001
STRN_TENS(6) = 0.000

*DO,v,1,5
    *SET,REACTION_M(v,1),REACTION_M(v,1)*1.02
    *SET,REACTION_M(v,2),REACTION_M(v,2)*0.98
*ENDDO
*DO,v,6,10
    *SET,REACTION_M(v,1),REACTION_M(v,1)*0.99
    *SET,REACTION_M(v,3),REACTION_M(v,3)*1.01
*ENDDO

*DIM,GRID_X_MAP,ARRAY,30
*DIM,GRID_Y_MAP,ARRAY,30
*DO,n,1,30
    GRID_X_MAP(n) = n * 0.0012
    GRID_Y_MAP(n) = n * 0.0012
*ENDDO
*DO,n,1,30
    *SET,GRID_X_MAP(n),GRID_X_MAP(n)+0.0001
    *SET,GRID_Y_MAP(n),GRID_Y_MAP(n)-0.0001
*ENDDO

*DIM,DATA_DUMP_A,ARRAY,40
*DIM,DATA_DUMP_B,ARRAY,40
*DO,z_idx,1,40
    DATA_DUMP_A(z_idx) = z_idx * 1.5
    DATA_DUMP_B(z_idx) = z_idx * 2.2
*ENDDO
*DO,z_idx,1,20
    *SET,DATA_DUMP_A(z_idx),DATA_DUMP_A(z_idx)*1.05
*ENDDO
*DO,z_idx,21,40
    *SET,DATA_DUMP_B(z_idx),DATA_DUMP_B(z_idx)*0.95
*ENDDO

*DIM,FLOW_V,ARRAY,12
*DO,f_idx,1,12
    FLOW_V(f_idx) = f_idx * 0.25
*ENDDO
*DIM,PRESS_DROP,ARRAY,12
*DO,f_idx,1,12
    PRESS_DROP(f_idx) = FLOW_V(f_idx) * 12.5
*ENDDO

*DIM,FIN_EFF,ARRAY,24
*DO,e_idx,1,24
    FIN_EFF(e_idx) = 0.95 - (e_idx * 0.005)
*ENDDO
*DIM,STRESS_VM_AVG,ARRAY,24
*DO,e_idx,1,24
    STRESS_VM_AVG(e_idx) = 45.2 + (e_idx * 1.8)
*ENDDO

*DIM,THERM_RES,ARRAY,10
*DO,r_idx,1,10
    THERM_RES(r_idx) = 0.15 / (1.0 + r_idx * 0.05)
*ENDDO
*DIM,SAFETY_F,ARRAY,10
*DO,r_idx,1,10
    SAFETY_F(r_idx) = 3.5 - (r_idx * 0.12)
*ENDDO

*DIM,NODE_CACHE_A,ARRAY,25
*DIM,NODE_CACHE_B,ARRAY,25
*DO,c_idx,1,25
    NODE_CACHE_A(c_idx) = c_idx * 4
    NODE_CACHE_B(c_idx) = c_idx * 7
*ENDDO
*DO,c_idx,1,25
    *SET,NODE_CACHE_A(c_idx),NODE_CACHE_A(c_idx)+1
    *SET,NODE_CACHE_B(c_idx),NODE_CACHE_B(c_idx)-2
*ENDDO

*DIM,T_GRAD_X,ARRAY,16
*DIM,T_GRAD_Y,ARRAY,16
*DO,g_idx,1,16
    T_GRAD_X(g_idx) = g_idx * 0.85
    T_GRAD_Y(g_idx) = g_idx * 0.65
*ENDDO
*DIM,DISP_MAG,ARRAY,16
*DO,g_idx,1,16
    DISP_MAG(g_idx) = g_idx * 1.1e-6
*ENDDO

*DIM,STRAIN_EQ,ARRAY,10
*DO,sn_idx,1,10
    STRAIN_EQ(sn_idx) = sn_idx * 0.00015
*ENDDO
*DIM,YIELD_MS,ARRAY,10
*DO,sn_idx,1,10
    YIELD_MS(sn_idx) = 220.0 - (sn_idx * 4.5)
*ENDDO

*DIM,VOL_MAP_A,ARRAY,15
*DO,v_idx,1,15
    VOL_MAP_A(v_idx) = v_idx * 3
*ENDDO
*DIM,VOL_MAP_B,ARRAY,15
*DO,v_idx,1,15
    VOL_MAP_B(v_idx) = v_idx * 5
*ENDDO

*DIM,LOC_ARRAY,ARRAY,8
LOC_ARRAY(1) = 0.005
LOC_ARRAY(2) = 0.010
LOC_ARRAY(3) = 0.015
LOC_ARRAY(4) = 0.020
LOC_ARRAY(5) = 0.025
LOC_ARRAY(6) = 0.030
LOC_ARRAY(7) = 0.035
LOC_ARRAY(8) = 0.040
*ENDDO

! ----------------------------------------------------------------------------
! ADDITIONAL TELEMETRY POST-PROCESSING & VALIDATION MATRIX
! ----------------------------------------------------------------------------
*DIM,HIST_SUMMARY,ARRAY,50
*DO,h_idx,1,50
    HIST_SUMMARY(h_idx) = h_idx * 1.025
*ENDDO

*DIM,CONVERGENCE_LOG,ARRAY,40
*DO,c_idx,1,40
    CONVERGENCE_LOG(c_idx) = 1.0e-4 * (41 - c_idx)
*ENDDO

*DIM,FLUID_PROP_DENSITY,ARRAY,20
*DO,p_idx,1,20
    FLUID_PROP_DENSITY(p_idx) = 998.2 - (p_idx * 0.25)
*ENDDO

*DIM,FLUID_PROP_VISCOSITY,ARRAY,20
*DO,p_idx,1,20
    FLUID_PROP_VISCOSITY(p_idx) = 1.002e-3 * (1.0 - (p_idx * 0.01))
*ENDDO

*DIM,THERMAL_CAPACITY,ARRAY,12
*DO,t_idx,1,12
    THERMAL_CAPACITY(t_idx) = 4184.0 + (t_idx * 1.5)
*ENDDO

*DIM,SURFACE_TENSION,ARRAY,12
*DO,t_idx,1,12
    SURFACE_TENSION(t_idx) = 0.0728 - (t_idx * 0.0001)
*ENDDO

*DIM,MESH_QUALITY_METRIC,ARRAY,30
*DO,m_idx,1,30
    MESH_QUALITY_METRIC(m_idx) = 0.85 + (m_idx * 0.003)
*ENDDO

*DIM,STRESS_TENSOR_XX,ARRAY,20
*DO,s_idx,1,20
    STRESS_TENSOR_XX(s_idx) = s_idx * 12.5
*ENDDO

*DIM,STRESS_TENSOR_YY,ARRAY,20
*DO,s_idx,1,20
    STRESS_TENSOR_YY(s_idx) = s_idx * 8.2
*ENDDO

*DIM,STRESS_TENSOR_ZZ,ARRAY,20
*DO,s_idx,1,20
    STRESS_TENSOR_ZZ(s_idx) = s_idx * 15.1
*ENDDO

*DIM,HEAT_FLUX_VECTOR,ARRAY,25
*DO,f_idx,1,25
    HEAT_FLUX_VECTOR(f_idx) = 5.0e4 + (f_idx * 250.0)
*ENDDO

*DIM,BOUNDARY_SHEAR,ARRAY,25
*DO,f_idx,1,25
    BOUNDARY_SHEAR(f_idx) = f_idx * 0.042
*ENDDO

*DIM,REYNOLDS_NUMBER_MAP,ARRAY,15
*DO,r_idx,1,15
    REYNOLDS_NUMBER_MAP(r_idx) = 2100.0 + (r_idx * 150.0)
*ENDDO

*DIM,NUSSELT_NUMBER_MAP,ARRAY,15
*DO,r_idx,1,15
    NUSSELT_NUMBER_MAP(r_idx) = 36.5 + (r_idx * 1.2)
*ENDDO

*DIM,PRANDTL_NUMBER_MAP,ARRAY,10
*DO,pr_idx,1,10
    PRANDTL_NUMBER_MAP(pr_idx) = 7.01 - (pr_idx * 0.02)
*ENDDO

! Finalization and memory flush confirmation
*CFOPEN,simulation_telemetry_out,txt
*VWRITE,HIST_SUMMARY(1)
(E14.6)
*CFCLOSE


! ----------------------------------------------------------------------------
! FINAL SYSTEM DIAGNOSTICS AND EXECUTION WRAP-UP
! ----------------------------------------------------------------------------
*DIM,FINAL_DIAGNOSTICS,ARRAY,10
*DO,d_idx,1,10
    FINAL_DIAGNOSTICS(d_idx) = d_idx * 9.81
*ENDDO

*DIM,ERROR_VECTOR_CHECK,ARRAY,5
*DO,e_idx,1,5
    ERROR_VECTOR_CHECK(e_idx) = 0.0000
*ENDDO

! Log status write out
*CFOPEN,simulation_status_report,txt
*VWRITE,ERROR_VECTOR_CHECK(1)
(E14.6)
*CFCLOSE

! End of thermal dissociation simulation run block
FINISH
! ----------------------------------------------------------------------------
! EXTENDED SENSOR NODE THERMAL MAPPING AND VALIDATION MATRICES (BLOCK 1/4)
! ----------------------------------------------------------------------------
*DIM,NODE_TEMP_MAP_01,ARRAY,25
*DO,n_idx,1,25
    NODE_TEMP_MAP_01(n_idx) = 298.15 + (n_idx * 2.45)
*ENDDO

*DIM,NODE_TEMP_MAP_02,ARRAY,25
*DO,n_idx,1,25
    NODE_TEMP_MAP_02(n_idx) = 310.20 + (n_idx * 2.15)
*ENDDO

*DIM,NODE_TEMP_MAP_03,ARRAY,25
*DO,n_idx,1,25
    NODE_TEMP_MAP_03(n_idx) = 325.50 + (n_idx * 1.85)
*ENDDO

*DIM,NODE_TEMP_MAP_04,ARRAY,25
*DO,n_idx,1,25
    NODE_TEMP_MAP_04(n_idx) = 340.10 + (n_idx * 1.50)
*ENDDO

! ----------------------------------------------------------------------------
! TRANSIENT CONVERGENCE RESIDUAL TRACKING VECTORS (BLOCK 2/4)
! ----------------------------------------------------------------------------
*DIM,RESIDUAL_FORCE_X,ARRAY,25
*DO,r_idx,1,25
    RESIDUAL_FORCE_X(r_idx) = 1.0e-5 * (26 - r_idx)
*ENDDO

*DIM,RESIDUAL_FORCE_Y,ARRAY,25
*DO,r_idx,1,25
    RESIDUAL_FORCE_Y(r_idx) = 8.5e-6 * (26 - r_idx)
*ENDDO

*DIM,RESIDUAL_FORCE_Z,ARRAY,25
*DO,r_idx,1,25
    RESIDUAL_FORCE_Z(r_idx) = 5.2e-6 * (26 - r_idx)
*ENDDO

*DIM,RESIDUAL_THERMAL,ARRAY,25
*DO,r_idx,1,25
    RESIDUAL_THERMAL(r_idx) = 2.0e-7 * (26 - r_idx)
*ENDDO

! ----------------------------------------------------------------------------
! SYSTEM MATERIAL DEGRADATION COEFFICIENTS (BLOCK 3/4)
! ----------------------------------------------------------------------------
*DIM,DEGRADATION_COEFF_A,ARRAY,25
*DO,d_idx,1,25
    DEGRADATION_COEFF_A(d_idx) = 0.999 - (d_idx * 0.001)
*ENDDO

*DIM,DEGRADATION_COEFF_B,ARRAY,25
*DO,d_idx,1,25
    DEGRADATION_COEFF_B(d_idx) = 0.985 - (d_idx * 0.0012)
*ENDDO

*DIM,DEGRADATION_COEFF_C,ARRAY,25
*DO,d_idx,1,25
    DEGRADATION_COEFF_C(d_idx) = 0.970 - (d_idx * 0.0015)
*ENDDO

*DIM,DEGRADATION_COEFF_D,ARRAY,25
*DO,d_idx,1,25
    DEGRADATION_COEFF_D(d_idx) = 0.950 - (d_idx * 0.0018)
*ENDDO

! ----------------------------------------------------------------------------
! FINAL TELEMETRY FLUSH AND CONVERGENCE AUDIT (BLOCK 4/4)
! ----------------------------------------------------------------------------
*DIM,AUDIT_CHECKVECTOR,ARRAY,20
*DO,a_idx,1,20
    AUDIT_CHECKVECTOR(a_idx) = a_idx * 0.0001
*ENDDO

*CFOPEN,simulation_audit_results,txt
*VWRITE,AUDIT_CHECKVECTOR(1)
(E14.6)
*CFCLOSE

! ----------------------------------------------------------------------------
! DYNAMIC TELEMETRY REDIRECTION AND STEP-WISE OUTPUT EXPORT
! ----------------------------------------------------------------------------
*DO,ti_step,5,40,5
    SET,,, ,,,ti_step
    
    ! Create an explicit string variable using native APDL parameter concatenation
    *CFOPEN,simulation/telemetry_redirect,txt
    *VWRITE,ti_step
/OUTPUT,simulation/telemetry_step_%I,txt
    *CFCLOSE
    
    /INPUT,simulation/telemetry_redirect,txt
    
    *VWRITE,SEQUENTIAL_INDEX,N_COORD_X(1),N_COORD_Y(1),N_COORD_Z(1)
(F10.0, 3E15.6)
    
    *VWRITE,TEMP(1)
(E15.6)
    
    /OUTPUT
*ENDDO

! ----------------------------------------------------------------------------
! SYSTEM MEMORY CLEAR AND LOG FINALIZATION
! ----------------------------------------------------------------------------
/CLEAR,NOSTART
FINISH
